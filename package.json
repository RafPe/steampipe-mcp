{
  "name": "@turbot/steampipe-mcp",
  "version": "0.2.1",
  "description": "Steampipe MCP server to query cloud infrastructure, SaaS, code and more with SQL using AI.",
  "license": "Apache-2.0",
  "author": "Turbot HQ, Inc",
  "homepage": "https://github.com/turbot/steampipe-mcp",
  "bugs": "https://github.com/turbot/steampipe-mcp/issues",
  "type": "module",
  "bin": {
    "mcp-server-steampipe": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && shx chmod +x dist/index.js",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run build",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:db": "node -e \"if(!process.env.TEST_DATABASE_URL){console.error('TEST_DATABASE_URL is required for test:db');process.exit(1)}\" && vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai",
    "cnapp",
    "cspm",
    "mcp",
    "mcp-server",
    "security",
    "steampipe",
    "turbot-pipes"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.18.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "pg": "8.23.1",
    "pg-cursor": "2.22.1",
    "pg-types": "4.0.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.11.12",
    "@types/pg-cursor": "2.7.2",
    "shx": "0.3.4",
    "typescript": "5.8.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "fast-uri": "3.1.9"
  }
}
